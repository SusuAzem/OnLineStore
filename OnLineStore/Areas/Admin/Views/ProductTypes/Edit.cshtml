@using OnLineStore.ViewModels
@model ProductTypeViewModel


@{
    ViewData["Title"] = "تعديل نوع المنتج";
}

<div class="d-flex" id="wrapper">
    <partial name="_Navbar" />
    <!-- Page Content -->
    <div id="page-content-wrapper">       
        <h4 class="text-info">@ViewData["Title"]</h4>
        <form asp-area="Admin" asp-controller="ProductTypes" asp-action="Edit" method="post">
            <div class="p4 rounded border row">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group row">
                    <div class="col-3">
                        <label asp-for="Type"></label>
                    </div>
                    <div class="col-6">
                        <input asp-for="Type" class="form-control" />
                    </div>
                    <span asp-validation-for="Type" class="text-danger"></span>
                </div>
                <br />
                <br />
                <div class="form-group">
                    <input type="submit" class="btn" value="تعديل" />
                    <a asp-area="Admin" asp-controller="ProductTypes" asp-action="Index" class="btn">العودة للقائمة</a>
                </div>
            </div>
        </form>
    </div>
</div>
@section scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}