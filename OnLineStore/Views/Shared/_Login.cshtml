@using System.Security.Claims
@{
    string? nameId = null;
    if (User.Identity!.IsAuthenticated)
    {
        nameId = User.Claims.FirstOrDefault(m => m.Type == ClaimTypes.NameIdentifier)!.Value;
    }
}
<ul class="navbar-nav loging">
    @if (User.Identity!.IsAuthenticated)
    {
        <li class="nav-item ">
            <a class="nav-link text-dark" asp-area="UserData" asp-controller="Panal" asp-action="FrontPage" asp-route-nameId="@nameId">
                مرحباً @User.Identity.Name
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Store" asp-controller="Account" asp-action="Logout">تسجيل الخروج</a>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark " asp-area="Store" asp-controller="Account" asp-action="Login" tooltip="تسجيل الدخول">
                <img id="gl" src="~/images/web_light_rd_na@4x.png" alt="تسجيل الدخول" />
            </a>
        </li>
    }
</ul>