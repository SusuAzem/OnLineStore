@model ButtonViewModel 

<td style="width: 150px">
    <div class="btn-group">
        <a asp-area="@Model.Area" asp-controller="@Model.Controller" asp-action="Edit" class="btn" asp-route-id="@Model.ItemId" hidden="@Model.B1">
            <i class="fa fa-edit"></i>
        </a>
        <a asp-area="@Model.Area" asp-controller="@Model.Controller" asp-action="Details" class="btn" asp-route-id="@Model.ItemId" hidden="@Model.B2">
            <i class="fa fa-list-alt" ></i>
        </a>
        <a asp-area="@Model.Area" asp-controller="@Model.Controller" asp-action="Delete" class="btn danger" asp-route-id="@Model.ItemId" hidden="@Model.B3">
            <i class="fa fa-trash"></i>
        </a>
    </div>
</td> 